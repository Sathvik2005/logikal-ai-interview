{
  "name": "logikality-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@logikality/web",
    "dev:backend": "npm run start:dev --workspace=lokality-backend",
    "build:web": "npm run build --workspace=@logikality/web",
    "build:backend": "npm run build --workspace=lokality-backend",
    "prisma:generate": "npm run prisma:generate --workspace=lokality-backend",
    "db:push": "npm run prisma:db:push --workspace=lokality-backend"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
