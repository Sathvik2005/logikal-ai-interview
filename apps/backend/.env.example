# Copy to .env (never commit .env). In production set NODE_ENV=production; the backend then
# refuses to start with mock/placeholder RESEND_API_KEY, short JWT_SECRET or no FRONTEND_URL.
NODE_ENV=development
PORT=3000

# Postgres (Supabase pooler for runtime, direct for migrations/prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=            # Supabase JWT secret, >= 32 chars

# AI + email
GEMINI_API_KEY=
RESEND_API_KEY=        # real re_... key in production

# CORS: exact origin of the deployed web app, e.g. https://app.example.com
FRONTEND_URL=

# AI models. Use "-latest" aliases: pinned model names get retired (gemini-2.0-flash and 2.5 already were).
# FLASH is used for latency-sensitive work (resume/JD parsing, live interview turns): keep it a lite/fast model.
# PRO is used for post-interview evaluation (runs in the background queue). With a paid key set
# GEMINI_PRO_MODEL=gemini-pro-latest.
GEMINI_FLASH_MODEL=gemini-flash-lite-latest
GEMINI_PRO_MODEL=gemini-flash-latest

# Optional: Redis for multi-instance live interviews (Socket.IO adapter). Unset = single instance only.
REDIS_URL=
# Optional: Slack/Teams/Discord-style webhook that is posted when a 5xx error happens (deduped per cooldown).
ERROR_ALERT_WEBHOOK_URL=
ERROR_ALERT_COOLDOWN_SEC=300
