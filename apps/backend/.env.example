# Copy to .env (never commit .env). In production set NODE_ENV=production; the backend then
# refuses to start with mock/placeholder RESEND_API_KEY, short JWT_SECRET or no FRONTEND_URL.
NODE_ENV=development
PORT=3000

# Postgres (Supabase pooler for runtime, direct for migrations/prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=            # Supabase JWT secret, >= 32 chars

# AI + email
GEMINI_API_KEY=
RESEND_API_KEY=        # real re_... key in production

# CORS: exact origin of the deployed web app, e.g. https://app.example.com
FRONTEND_URL=
